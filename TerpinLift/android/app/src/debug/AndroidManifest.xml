<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Overrides the main manifest's label for debug builds only (manifest
         merge) — combined with build.gradle.kts's debug-only
         applicationIdSuffix, this makes a `flutter run` install visually and
         structurally distinct from the real app on the home screen, not just
         under the hood. See designFiles/14_PLAY_STORE_RELEASE.md "Local
         testing vs. the real app." -->
    <application android:label="TerrapinLift Dev" tools:replace="android:label"/>
</manifest>
